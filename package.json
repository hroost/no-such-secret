{
  "name": "no-such-secret",
  "version": "0.1.0",
  "private": true,
  "description": "MIT-licensed, client-side encrypted, one-time secret sharing for Cloudflare.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint .",
    "deploy:dry-run": "pnpm run build && pnpm exec wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "pnpm run build && pnpm exec wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.10",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
